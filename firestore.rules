// Firestore 규칙. 바꾼 뒤에는 Firebase 콘솔 > Firestore Database > 규칙 탭에 전체를 붙여넣고 게시한다.
//
// 관리자 지정 (콘솔에서 손으로, 한 번만)
//   1. 사이트에서 관리자로 쓸 구글 계정으로 로그인한 뒤 admin/index.html 을 열면 내 uid 가 보인다.
//   2. Firestore Database > 데이터 > 컬렉션 시작 > 컬렉션 ID "admins"
//      > 문서 ID 에 그 uid 를 그대로 넣고, 필드는 아무거나 하나 (예: name, 문자열, 내 이름) > 저장.
//   admins 문서는 사이트에서 누구도 만들거나 고칠 수 없다. 콘솔에서만 넣고 뺀다.
//
// 저장 구조
//   admins/{uid}                        관리자 표시. 콘솔에서만 만든다
//   users/{uid}                         프로필 {email, name, updatedAt}. 로그인할 때 본인이 쓴다
//   users/{uid}/stores/{id}             공부 기록 (assets/sync.js)
//   users/{uid}/passes/{passId}         이용권 {kind, scope, expiresAt, source, code?, by?, createdAt}
//        kind: subject(과목 하나) | month | year | days(전체 과목 N일).  scope: 과목 키 또는 "*"
//        관리자가 준 것은 passId 자유, 코드로 받은 것은 passId = "c_" + 코드
//   codes/{코드}                         이벤트 코드 {kind, scope, days, maxUses, used, active, expiresAt, note, createdAt, createdBy}
//   codes/{코드}/redemptions/{uid}        코드를 쓴 사람 {uid, email, at}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // 관리자 표시: 본인 것만 읽을 수 있고, 사이트에서는 아무도 못 쓴다
    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // 프로필: 본인이 자기 이메일로만 쓴다. 관리자가 찾아볼 수 있다
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow delete: if false;
    }

    // 각자 자기 기록만 읽고 쓴다. users/{uid}/stores/{과목키} = {data: 문자열, updatedAt}
    match /users/{uid}/stores/{key} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    // 이용권
    match /users/{uid}/passes/{passId} {
      allow read: if isSelf(uid) || isAdmin();
      // 관리자는 누구에게나 주고 고치고 회수한다
      allow create, update: if isAdmin() && validPass(request.resource.data);
      allow delete: if isAdmin();
      // 본인은 이벤트 코드를 쓸 때만, 코드 내용과 똑같은 이용권 하나를 만든다
      allow create: if isSelf(uid) && redeemPass(uid, passId, request.resource.data);
    }

    function validPass(p) {
      return p.kind in ['subject', 'month', 'year', 'days']
        && p.scope is string && p.scope.size() > 0 && p.scope.size() <= 60
        && (p.kind == 'subject' ? p.scope != '*' : p.scope == '*')
        && p.expiresAt is timestamp;
    }

    function redeemPass(uid, passId, p) {
      let codePath = /databases/$(database)/documents/codes/$(p.code);
      let c = get(codePath).data;
      return p.keys().hasOnly(['kind', 'scope', 'expiresAt', 'source', 'code', 'createdAt'])
        && p.source == 'code'
        && p.code is string && p.code.matches('^[A-Z0-9!]{6,32}$')
        && passId == 'c_' + p.code
        && p.createdAt == request.time
        && c.active == true
        && request.time < c.expiresAt
        && c.used < c.maxUses
        && p.kind == c.kind
        && p.scope == c.scope
        && p.expiresAt is timestamp
        // 기기 시계 차이를 봐서 1시간까지만 여유를 둔다
        && p.expiresAt <= request.time + duration.value(c.days, 'd') + duration.value(1, 'h')
        // 같은 요청 안에서 코드 사용 횟수를 1 올리고, 사용 기록을 남겨야 한다
        && getAfter(codePath).data.used == c.used + 1
        && existsAfter(/databases/$(database)/documents/codes/$(p.code)/redemptions/$(uid));
    }

    // 이벤트 코드: 목록은 관리자만. 일반 사용자는 코드를 정확히 알 때 그 한 개만 읽는다
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && code.matches('^[A-Z0-9!]{6,32}$')
        && request.resource.data.kind in ['subject', 'month', 'year', 'days']
        && request.resource.data.days is int && request.resource.data.days > 0 && request.resource.data.days <= 400
        && request.resource.data.maxUses is int && request.resource.data.maxUses > 0
        && request.resource.data.used is int
        && request.resource.data.expiresAt is timestamp;
      allow delete: if isAdmin();
      // 사용자는 코드를 쓸 때 used 를 딱 1 올리는 것만 할 수 있다
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == resource.data.used + 1
        && resource.data.used < resource.data.maxUses
        && resource.data.active == true
        && request.time < resource.data.expiresAt
        && !exists(/databases/$(database)/documents/codes/$(code)/redemptions/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/codes/$(code)/redemptions/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/passes/$('c_' + code));

      match /redemptions/{uid} {
        allow read: if isAdmin();
        allow delete: if isAdmin();
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'email', 'at'])
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/codes/$(code)).data.used
             == get(/databases/$(database)/documents/codes/$(code)).data.used + 1
          && existsAfter(/databases/$(database)/documents/users/$(uid)/passes/$('c_' + code));
      }
    }
  }

  // ===================== 친구 전용 펫 v3 (2026-09-17, 펫 프로그램 1.3.0 과 사이트 pet/) =====================
  // 모두 새로 시작: 예전 petCodes, petFriends, petPresence, petChats, petInbox, plaza 는 규칙이 없어서 아무도 못 읽고 못 쓴다 (콘솔에서 지워도 된다).
  // 펫 이름은 모두 달라야 하고 한 사람은 이름 하나만 가진다. 친구 추가는 친구의 펫 이름으로 한다.
  //   pet3Owners/{uid}                   내 펫 이름표 {name: 이름 열쇠, pet: 보이는 이름, sp, who: 키우는 사람 이름(20글자까지), ts}. 나만 읽는다
  //   pet3Names/{열쇠}                    이름 자리 {uid, pet, sp}. 이름을 정확히 알 때 한 장만 읽는다 (목록 금지)
  //        열쇠 = 보이는 이름에서 띄어쓰기를 빼고 영문을 소문자로 바꾼 것. 한글, 영문, 숫자 1~8글자
  //        이름표와 이름 자리는 한 요청 안에서 같이 쓴다. 새 이름 자리를 잡으면서 예전 이름 자리는 비워야 한다
  //   pet3Friends/{uid}/list/{other}     "나는 other 와 친구 하고 싶다" {pet, sp, ts}. 양쪽에 다 있어야 친구
  //   pet3Friends/{uid}/requests/{from}  받은 친구 요청 {name, pet, sp, via, ts}. via = 받는 사람 펫 이름 열쇠
  //   pet3Presence/{uid}                 접속 표시 {name, sp, wear, tricks(배운 개인기 id 목록), owner(이름표의 who), act(하는 일), mood, ev(최근 일 10개 {k, a, t}), ct(쓴 기기 시각), ts}. name 은 내 이름표의 pet 과 같아야 한다. 서로 친구만 읽는다
  //   pet3Chats/{a_b}/messages/{id}      1:1 대화 {from, text, ts, deleted?, deletedAt?}. a_b 는 두 uid 를 정렬해 _ 로 이은 것
  //   pet3Board/{uid}/messages/{id}      전체 채팅: 내 친구 모두에게 한 말 {from, text, ts, deleted?, deletedAt?}. 나와 서로 친구만 읽는다
  //        2026-09-18 (펫 프로그램 1.4.7): 대화 기록은 지우지 않고 서버에 남긴다. 보낸 사람이 지우면 deleted, deletedAt 만 붙인다(소프트 삭제).
  //        관리자(admins/{uid})는 안전과 운영을 위해 모든 대화(지운 것 포함)와 이름표, 친구 목록을 읽을 수 있다 (사이트 관리자 페이지 "대화 기록")
  //   pet3Inbox/{uid}                    알림 {보낸 친구 uid: 1:1 새 메시지, p_uid: 콕 찌르기, b_uid: 전체 채팅 새 글}. 친구는 자기 칸 세 개만 고친다
  //   users/{uid}/stores/pet3__state     펫 상태 (위 stores 규칙). 사이트와 펫 프로그램이 같이 쓴다
  //   pet3Rtc/{a_b}/sig/{id}             펫 프로그램 1.4.8 파일 바로 보내기 신호 {from, to, kind, xfer, sdp, ts}. 서로 친구 둘만 읽고 쓰고 지운다(고치기 없음).
  //        파일 내용은 서버에 가지 않는다. 1:1 메시지에 file {id, name, size, type, sha} 칸이 붙을 수 있다
  match /databases/{database}/documents {
    function p3In() { return request.auth != null; }
    function p3Me(uid) { return request.auth != null && request.auth.uid == uid; }
    function p3Admin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // 소프트 삭제: deleted, deletedAt 만 바꾸고 deleted 는 true, deletedAt 은 지금 시각 (글은 못 고친다)
    function p3SoftDelete() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
        && request.resource.data.deleted == true && request.resource.data.deletedAt == request.time;
    }
    // 관리자: 지운 메시지를 되살리거나(삭제 취소: deleted, deletedAt 을 없애고 restoredBy, restoredAt 을 적음) 운영상 삭제 표시만. 글은 못 고친다
    function p3AdminMark() {
      let d = request.resource.data;
      return p3Admin() && d.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'restoredBy', 'restoredAt'])
        && (((!('deleted' in d) || d.deleted == false) && d.restoredBy == request.auth.uid && d.restoredAt == request.time)
          || (d.deleted == true && d.deletedAt == request.time));
    }
    function p3Doc(rel) { return path('/databases/' + database + '/documents/' + rel); }
    function p3Wants(a, b) { return exists(/databases/$(database)/documents/pet3Friends/$(a)/list/$(b)); }
    // 서로 친구: 내 목록에 상대가, 상대 목록에 내가 있다
    function p3Mutual(other) {
      return request.auth != null && other != request.auth.uid
        && p3Wants(request.auth.uid, other) && p3Wants(other, request.auth.uid);
    }
    function p3Str(v, n) { return v is string && v.size() <= n; }
    function p3Sp(v) { return v is string && v.matches('[a-z0-9_-]{1,20}'); }
    function p3Key(k) { return k is string && k.matches('[a-z0-9가-힣]{1,8}'); }
    // 보이는 이름: 한글, 영문, 숫자, 글자 사이 띄어쓰기 한 칸. 8글자까지
    function p3Pet(v) { return v is string && v.size() <= 8 && v.matches('[A-Za-z0-9가-힣]( ?[A-Za-z0-9가-힣])*'); }
    function p3KeyOf(v) { return v.lower().replace(' ', ''); }
    function p3Wear(w) {
      return w is map && w.keys().hasOnly(['head', 'neck', 'face'])
        && (!('head' in w) || p3Str(w.head, 20))
        && (!('neck' in w) || p3Str(w.neck, 20))
        && (!('face' in w) || p3Str(w.face, 20));
    }
    // 1.4.8 파일 메시지의 파일 정보 (이름, 크기, 종류, sha256, 전송 id)
    function p3FileMeta(f) {
      return f is map && f.keys().hasOnly(['id', 'name', 'size', 'type', 'sha'])
        && p3Str(f.id, 40) && f.name is string && f.name.size() > 0 && f.name.size() <= 120
        && f.size is int && f.size >= 0 && p3Str(f.type, 80) && p3Str(f.sha, 64);
    }
    function p3InPair(pair) {
      let p = pair.split('_');
      return p.size() == 2
        && ((p[0] == request.auth.uid && p3Mutual(p[1])) || (p[1] == request.auth.uid && p3Mutual(p[0])));
    }

    // 내 펫 이름표: 새 이름 자리가 (같은 요청이 끝난 뒤) 내 것이어야 하고, 이름을 바꾸면 예전 자리는 비워야 한다
    // 키우는 사람 이름: 친구에게 보여 줄 이름 (구글 이름이 기본, 바꿀 수 있음). 1~20글자
    function p3Who(v) { return v is string && v.size() > 0 && v.size() <= 20; }
    function p3OwnerOk(uid, oldName) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'pet', 'sp', 'who', 'ts'])
        && p3Key(d.name) && p3Pet(d.pet) && p3KeyOf(d.pet) == d.name && p3Sp(d.sp)
        && (!('who' in d) || p3Who(d.who))
        && d.ts == request.time
        && getAfter(p3Doc('pet3Names/' + d.name)).data.uid == uid
        && (oldName == '' || oldName == d.name
          || !existsAfter(p3Doc('pet3Names/' + oldName))
          || getAfter(p3Doc('pet3Names/' + oldName)).data.uid != uid);
    }
    match /pet3Owners/{uid} {
      allow get: if p3Me(uid) || p3Admin();
      allow list: if p3Admin();
      allow create: if p3Me(uid) && p3OwnerOk(uid, '');
      // 이름이나 종을 바꾸는 것은 5초에 한 번까지
      allow update: if p3Me(uid) && p3OwnerOk(uid, resource.data.name) && request.time > resource.data.ts + duration.value(5, 's');
      // 펫 떠나보내기: 같은 요청에서 내 이름 자리도 비워야 이름표를 지울 수 있다
      allow delete: if p3Me(uid)
        && (!existsAfter(p3Doc('pet3Names/' + resource.data.name))
          || getAfter(p3Doc('pet3Names/' + resource.data.name)).data.uid != uid);
    }

    // 이름 자리: 먼저 잡은 사람 것. 없는 자리만 만들 수 있고, 내 자리만 고치거나 비운다
    match /pet3Names/{key} {
      allow get: if p3In();
      allow list: if false;
      allow create: if p3In() && p3Key(key)
        && request.resource.data.keys().hasOnly(['uid', 'pet', 'sp'])
        && request.resource.data.uid == request.auth.uid
        && p3Pet(request.resource.data.pet) && p3KeyOf(request.resource.data.pet) == key
        && p3Sp(request.resource.data.sp)
        && getAfter(p3Doc('pet3Owners/' + request.auth.uid)).data.name == key;
      allow update: if p3In() && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'pet', 'sp'])
        && request.resource.data.uid == request.auth.uid
        && p3Pet(request.resource.data.pet) && p3KeyOf(request.resource.data.pet) == key
        && p3Sp(request.resource.data.sp)
        && getAfter(p3Doc('pet3Owners/' + request.auth.uid)).data.name == key;
      // 이름표가 아직 이 자리를 가리키면 못 비운다 (이름을 바꿀 때 같은 요청에서 비운다)
      allow delete: if p3In() && resource.data.uid == request.auth.uid
        && (!existsAfter(p3Doc('pet3Owners/' + request.auth.uid))
          || getAfter(p3Doc('pet3Owners/' + request.auth.uid)).data.name != key);
    }

    match /pet3Friends/{owner} {
      allow read, write: if false;

      // 친구 목록: 내 목록은 나만 만든다. 상대는 "자기를 가리키는 문서" 하나를 확인(get)하거나 지울(친구 끊기) 수만 있다
      match /list/{other} {
        allow get: if p3In() && (request.auth.uid == owner || request.auth.uid == other || p3Admin());
        allow list: if p3Me(owner) || p3Admin();
        allow create, update: if p3Me(owner) && owner != other
          && request.resource.data.keys().hasOnly(['pet', 'sp', 'who', 'ts'])
          && p3Str(request.resource.data.pet, 8) && p3Sp(request.resource.data.sp)
          && (!('who' in request.resource.data) || p3Str(request.resource.data.who, 60))
          && request.resource.data.ts == request.time;
        allow delete: if p3In() && (request.auth.uid == owner || request.auth.uid == other);
      }

      // 친구 요청: 받는 사람의 지금 펫 이름을 알아야 하고, 보내는 펫 이름은 내 이름표와 같아야 하고,
      // 같은 요청 안에서 내 목록에도 받는 사람을 적어야 한다. 받는 사람이 수락(자기 목록에 적기)해야 친구가 된다
      match /requests/{from} {
        allow get, delete: if p3In() && (request.auth.uid == owner || request.auth.uid == from);
        allow list: if p3Me(owner);
        allow create, update: if p3Me(from) && from != owner
          && request.resource.data.keys().hasOnly(['name', 'pet', 'sp', 'via', 'ts'])
          && p3Str(request.resource.data.name, 60)
          && (request.resource.data.name == '' || request.resource.data.name == request.auth.token.get('name', '')
            || request.resource.data.name == get(p3Doc('pet3Owners/' + from)).data.get('who', ''))
          && p3Key(request.resource.data.via)
          && get(p3Doc('pet3Names/' + request.resource.data.via)).data.uid == owner
          && request.resource.data.pet == get(p3Doc('pet3Owners/' + from)).data.pet
          && p3Sp(request.resource.data.sp)
          && request.resource.data.ts == request.time
          && existsAfter(p3Doc('pet3Friends/' + from + '/list/' + owner));
      }
    }

    // 접속 표시: 나와 서로 친구만 읽는다 (문서 id 로 한 장씩, 목록 금지). 이름은 내 이름표 그대로
    match /pet3Presence/{uid} {
      allow get: if p3Me(uid) || p3Mutual(uid);
      allow list: if false;
      allow create, update: if p3Me(uid)
        && request.resource.data.keys().hasOnly(['name', 'sp', 'wear', 'tricks', 'owner', 'act', 'mood', 'ev', 'ct', 'ts'])
        && (!('act' in request.resource.data) || (request.resource.data.act is string && request.resource.data.act.size() <= 12))
        && (!('mood' in request.resource.data) || (request.resource.data.mood is string && request.resource.data.mood.size() <= 8))
        && (!('ev' in request.resource.data) || (request.resource.data.ev is list && request.resource.data.ev.size() <= 10))
        && (!('ct' in request.resource.data) || request.resource.data.ct is int)
        && request.resource.data.name == get(p3Doc('pet3Owners/' + uid)).data.pet
        && (!('owner' in request.resource.data) || request.resource.data.owner == get(p3Doc('pet3Owners/' + uid)).data.get('who', ''))
        && (!('tricks' in request.resource.data) || (request.resource.data.tricks is list && request.resource.data.tricks.size() <= 10))
        && p3Sp(request.resource.data.sp)
        && (!('wear' in request.resource.data) || p3Wear(request.resource.data.wear))
        && request.resource.data.ts == request.time;
      allow delete: if p3Me(uid);
    }

    // 1:1 대화: 두 사람이 서로 친구일 때만 읽고 쓴다. 내 이름으로만 쓰고, 글은 못 고친다.
    // 지우기는 내 글에 삭제 표시만 (문서는 남는다). 관리자는 모든 방을 읽는다
    match /pet3Chats/{pair}/messages/{id} {
      allow read: if (p3In() && p3InPair(pair)) || p3Admin();
      allow create: if p3In() && id.size() <= 40 && p3InPair(pair)
        && request.resource.data.keys().hasOnly(['from', 'text', 'ts', 'file'])
        && (!('file' in request.resource.data) || p3FileMeta(request.resource.data.file))
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 120
        && request.resource.data.ts == request.time;
      allow update: if (p3In() && resource.data.from == request.auth.uid && p3SoftDelete()) || p3AdminMark();
      allow delete: if false;
    }

    // 전체 채팅: 내 게시판에 나만 쓰고, 나와 서로 친구인 사람만 읽는다. 지우기는 삭제 표시만, 관리자는 모두 읽는다
    match /pet3Board/{owner}/messages/{id} {
      allow read: if p3Me(owner) || p3Mutual(owner) || p3Admin();
      allow create: if p3Me(owner) && id.size() <= 40
        && request.resource.data.keys().hasOnly(['from', 'text', 'ts'])
        && request.resource.data.from == owner
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 120
        && request.resource.data.ts == request.time;
      allow update: if (p3Me(owner) && p3SoftDelete()) || p3AdminMark();
      allow delete: if false;
    }

    // 알림: 주인만 읽는다. 서로 친구인 사람은 자기 칸 세 개만 지금 시각으로 바꾼다
    //   {내 uid}   1:1 새 메시지
    //   p_{내 uid} 콕 찌르기. 같은 칸의 이전 시각에서 30초가 지나야 다시 쓸 수 있다
    //   b_{내 uid} 전체 채팅에 새 글
    // 칸을 지우는 것은 주인만 (문서 삭제) 할 수 있어서 보낸 사람이 기다리는 시간을 없앨 수 없다
    function p3PokeKey() { return 'p_' + request.auth.uid; }
    function p3BoardKey() { return 'b_' + request.auth.uid; }
    function p3RtcKey() { return 'r_' + request.auth.uid; }
    function p3NowIfSet(k) { return !(k in request.resource.data) || request.resource.data[k] == request.time; }
    function p3NowIfChanged(k) {
      return !(k in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data[k] == request.time;
    }
    // 1.4.8 파일 바로 보내기 신호: 서로 친구 둘만. 새로 쓰기(내 이름으로, 상대에게)와 지우기만
    match /pet3Rtc/{pair}/sig/{id} {
      allow read, delete: if p3In() && p3InPair(pair);
      allow create: if p3In() && id.size() <= 40 && p3InPair(pair)
        && request.resource.data.keys().hasOnly(['from', 'to', 'kind', 'xfer', 'sdp', 'ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid && pair.split('_').hasAny([request.resource.data.to])
        && request.resource.data.kind in ['accept', 'offer', 'answer', 'cancel']
        && p3Str(request.resource.data.xfer, 40) && p3Str(request.resource.data.sdp, 30000)
        && request.resource.data.ts == request.time;
      allow update: if false;
    }

    match /pet3Inbox/{owner} {
      allow get, delete: if p3Me(owner);
      allow list: if false;
      allow create: if p3In() && request.auth.uid != owner
        && request.resource.data.keys().hasOnly([request.auth.uid, p3PokeKey(), p3BoardKey(), p3RtcKey()])
        && request.resource.data.size() > 0
        && p3NowIfSet(request.auth.uid) && p3NowIfSet(p3PokeKey()) && p3NowIfSet(p3BoardKey()) && p3NowIfSet(p3RtcKey())
        && p3Mutual(owner);
      allow update: if p3In() && request.auth.uid != owner
        && request.resource.data.diff(resource.data).affectedKeys().size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid, p3PokeKey(), p3BoardKey(), p3RtcKey()])
        && p3NowIfChanged(request.auth.uid) && p3NowIfChanged(p3BoardKey()) && p3NowIfChanged(p3RtcKey())
        && (!(p3PokeKey() in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data[p3PokeKey()] == request.time
            && (!(p3PokeKey() in resource.data) || request.time > resource.data[p3PokeKey()] + duration.value(30, 's'))))
        && request.resource.data.size() <= 450
        && p3Mutual(owner);
    }
  }
  // ===================== 친구 전용 펫 v3 끝 =====================

  // ===================== 펫 코인 선물 (2026-09-17, 관리자 페이지 "펫 코인 주기") =====================
  // 과목을 안 들어서 퀴즈로 코인을 못 모으는 사람에게 관리자가 펫 간식 돈을 보낸다.
  //   petCoinGrants/{id}  { uid: 받는 사람, email, name, amount: 1~5000, note: 60자까지, by: 보낸 관리자 uid, ts, claimed: false }
  //   받는 사람의 사이트 펫이나 펫 프로그램이 claimed 를 true 로 바꾼 뒤(같은 요청에 claimedAt) 자기 펫 상태에 코인을 더한다.
  //   이미 받은 것은 다시 true 로 못 바꿔서 여러 기기에서 두 번 받지 않는다.
  match /databases/{database}/documents {
    function pcIn() { return request.auth != null; }
    function pcAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /petCoinGrants/{id} {
      // 관리자는 모두, 받는 사람은 자기 것만 (목록은 where uid == 내 uid 로)
      allow read: if pcAdmin() || (pcIn() && resource.data.uid == request.auth.uid);
      allow create: if pcAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'amount', 'note', 'by', 'ts', 'claimed'])
        && request.resource.data.uid is string && request.resource.data.uid.size() > 0 && request.resource.data.uid.size() <= 128
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.amount is int && request.resource.data.amount >= 1 && request.resource.data.amount <= 5000
        && request.resource.data.note is string && request.resource.data.note.size() <= 60
        && request.resource.data.by == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.claimed == false;
      // 받기: 받는 사람만, 아직 안 받은 것을 받은 것으로만
      allow update: if pcIn() && resource.data.uid == request.auth.uid
        && resource.data.claimed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt'])
        && request.resource.data.claimed == true
        && request.resource.data.claimedAt == request.time;
      // 취소: 관리자만, 아직 안 받은 것만
      allow delete: if pcAdmin() && resource.data.claimed == false;
    }
  }
  // ===================== 펫 코인 선물 끝 =====================
}
